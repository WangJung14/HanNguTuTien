DISCORD_TOKEN=put_your_discord_bot_token_here
DISCORD_CLIENT_ID=put_your_application_id_here
DISCORD_DEV_GUILD_ID=put_your_test_server_id_here
DICTIONARY_DB_PATH=./data/cvdict-app.sqlite

# Tu Vi, túi từ và tiến độ lưu riêng khỏi từ điển CVDICT.
PROGRESS_DB_PATH=./data/progress.sqlite

# Dictation TTS. Default is offline Piper; configure a compatible Piper HTTP Server.
DICTATION_TTS_PROVIDER=piper
PIPER_TTS_URL=http://127.0.0.1:5000
PIPER_TTS_MODEL=zh_CN-huayan-medium
PIPER_TTS_TIMEOUT_MS=30000
DICTATION_AUDIO_CACHE_DIR=./data/dictation-audio-cache

# Optional reviewed HSK question pack for Phase 5.1.
PVE_QUESTION_PACK_PATH=./data/question-packs/hsk-sample.json

# Optional alternative provider (used only with DICTATION_TTS_PROVIDER=azure).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
